---
import type { Locale } from "@/data/profile"
import { getDictionary } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
---

<section id="sobre-mi" class="section-rail">
  <h2 class="section-label">{t.sections.about}</h2>
  <div class="max-w-2xl space-y-4 border-t border-border pt-6 text-sm leading-relaxed text-foreground/90">
    <p>{t.about.p1}</p>
    <p>{t.about.p2}</p>
  </div>
</section>
