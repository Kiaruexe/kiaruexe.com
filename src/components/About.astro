---
import { Separator } from "@/components/ui/separator"
import type { Locale } from "@/data/profile"
import { getDictionary } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
---

<section id="sobre-mi" class="section-rail">
  <h2 class="section-label">{t.sections.about}</h2>
  <div class="max-w-2xl text-sm leading-relaxed text-foreground/90">
    <Separator />
    <div class="space-y-4 pt-6">
      <p>{t.about.p1}</p>
      <p>{t.about.p2}</p>
    </div>
  </div>
</section>
