---
import { Mail } from "lucide-react"
import { buttonVariants } from "@/components/ui/button"
import { Separator } from "@/components/ui/separator"
import { profile, type Locale } from "@/data/profile"
import { getDictionary } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
---

<section id="contacto" class="section-rail">
  <h2 class="section-label">{t.sections.contact}</h2>
  <div>
    <Separator />
    <p class="mt-6 max-w-xl text-sm leading-relaxed text-muted-foreground">{t.contact.lead}</p>
    <div class="mt-5">
      <a
        href={`mailto:${profile.email}`}
        aria-label={t.contactAria}
        class={buttonVariants({ className: "rounded-md px-4" })}
      >
        <Mail data-icon="inline-start" />
        {t.contact.button}
      </a>
    </div>
    <p class="font-meta mt-3 text-sm text-muted-foreground">{profile.email}</p>
  </div>
</section>
