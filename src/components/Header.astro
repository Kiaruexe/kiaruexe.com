---
import { LangToggle } from "@/components/LangToggle"
import { ThemeToggle } from "@/components/ThemeToggle"
import type { Locale } from "@/data/profile"
import { getDictionary } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)

const links = [
  { href: "#proyectos", label: t.nav.projects },
  { href: "#experiencia", label: t.nav.experience },
  { href: "#formacion", label: t.nav.education },
  { href: "#skills", label: t.nav.skills },
  { href: "#sobre-mi", label: t.nav.about },
  { href: "#contacto", label: t.nav.contact },
]
---

<header class="sticky top-0 z-20 -mx-1 border-b border-border/60 bg-background/90 py-3 backdrop-blur-md">
  <div class="flex items-center justify-between gap-3">
    <a
      href={locale === "en" ? "/en" : "/"}
      class="font-display text-lg text-foreground no-underline"
    >
      {t.brand}
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label={t.brand}>
      {
        links.map((link) => (
          <a
            href={link.href}
            class="font-meta rounded px-2 py-1.5 text-[0.72rem] text-muted-foreground no-underline hover:text-foreground"
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-0.5">
      <LangToggle
        locale={locale}
        currentLabel={t.lang.current}
        esLabel={t.lang.es}
        enLabel={t.lang.en}
      />
      <ThemeToggle client:load lightLabel={t.theme.light} darkLabel={t.theme.dark} />
    </div>
  </div>

  <nav class="mt-2 flex flex-wrap gap-x-1 gap-y-0.5 md:hidden" aria-label={t.brand}>
    {
      links.map((link) => (
        <a
          href={link.href}
          class="font-meta rounded px-2 py-1 text-[0.7rem] text-muted-foreground no-underline hover:text-foreground"
        >
          {link.label}
        </a>
      ))
    }
  </nav>
</header>
