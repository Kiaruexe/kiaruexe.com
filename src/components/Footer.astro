---
import { Separator } from "@/components/ui/separator"
import type { Locale } from "@/data/profile"
import { getDictionary } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const year = new Date().getFullYear()
---

<div class="mt-4">
  <Separator />
  <footer class="flex flex-col gap-2 pt-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-meta text-sm text-muted-foreground">{t.footer}</p>
    <p class="font-meta font-nums text-sm text-muted-foreground">{year}</p>
  </footer>
</div>
