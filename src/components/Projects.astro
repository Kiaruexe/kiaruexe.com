---
import { Code, ExternalLink } from "lucide-react"
import ProjectCover from "@/components/ProjectCover.astro"
import { Badge } from "@/components/ui/badge"
import { buttonVariants } from "@/components/ui/button"
import { Separator } from "@/components/ui/separator"
import { profile, type Locale } from "@/data/profile"
import { getDictionary } from "@/i18n"

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const t = getDictionary(locale)
const iconLink = buttonVariants({
  variant: "ghost",
  size: "icon",
  className: "text-muted-foreground hover:text-primary",
})
---

<section id="proyectos" class="section-rail">
  <h2 class="section-label">{t.sections.projects}</h2>
  <div>
    <Separator />
    {
      profile.projects.map((project) => {
        const copy = t.projects[project.id]
        return (
          <article class="grid gap-4 border-b border-border py-6 sm:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] sm:gap-8">
            <ProjectCover id={project.id} image={project.image} title={copy.title} />
            <div class="flex min-w-0 flex-col justify-between gap-4">
              <div>
                <div class="flex items-start justify-between gap-3">
                  <h3 class="font-display text-lg leading-tight">{copy.title}</h3>
                  <div class="flex shrink-0 items-center gap-1">
                    <a
                      href={project.repo}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={`${t.repo}: ${copy.title}`}
                      class={iconLink}
                    >
                      <Code className="size-4" />
                    </a>
                    {project.demo ? (
                      <a
                        href={project.demo}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={`${t.demo}: ${copy.title}`}
                        class={iconLink}
                      >
                        <ExternalLink className="size-4" />
                      </a>
                    ) : null}
                  </div>
                </div>
                <p class="mt-2 text-sm leading-relaxed text-muted-foreground">{copy.blurb}</p>
              </div>
              <ul class="flex flex-wrap gap-1.5">
                {project.stack.map((tech) => (
                  <li>
                    <Badge variant="outline" className="rounded-sm font-meta">
                      {tech}
                    </Badge>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        )
      })
    }
  </div>
</section>
